APP_NAME=Surv API
DATABASE_URL=postgresql://surv:surv@localhost:5432/surv
REDIS_URL=redis://localhost:6379/0
PROJECT_UPLOADS_ROOT=./uploads/projects
PROJECT_ENVIRONMENT=development
# Set APPS_DOMAIN=example.com in production for https://<public_id>.example.com/
JWT_SECRET_KEY=replace-me

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
